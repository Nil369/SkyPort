{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "docs", "release": "patch" },
          { "type": "chore", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "ci", "release": "patch" },
          { "type": "build", "release": "patch" },
          { "scope": "release", "type": "chore", "release": "patch" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release-assets/skyport-server-linux-amd64",
            "label": "Linux AMD64"
          },
          {
            "path": "release-assets/skyport-server-linux-arm64",
            "label": "Linux ARM64"
          },
          {
            "path": "release-assets/skyport-server-darwin-amd64",
            "label": "macOS Intel"
          },
          {
            "path": "release-assets/skyport-server-darwin-arm64",
            "label": "macOS Apple Silicon"
          },
          {
            "path": "release-assets/skyport-server-windows-amd64.exe",
            "label": "Windows AMD64"
          },
          {
            "path": "release-assets/skyport-cli-linux-amd64",
            "label": "SkyPort CLI Linux AMD64"
          },
          {
            "path": "release-assets/skyport-cli-linux-arm64",
            "label": "SkyPort CLI Linux ARM64"
          },
          {
            "path": "release-assets/skyport-cli-darwin-amd64",
            "label": "SkyPort CLI macOS Intel"
          },
          {
            "path": "release-assets/skyport-cli-darwin-arm64",
            "label": "SkyPort CLI macOS Apple Silicon"
          },
          {
            "path": "release-assets/skyport-cli-windows-amd64.exe",
            "label": "SkyPort CLI Windows AMD64"
          }
        ]
      }
    ]
  ]
}