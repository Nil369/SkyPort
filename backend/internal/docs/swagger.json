    "definitions": {
        "internal_auth.AuthResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_at": {
                    "type": "string"
                },
                "refresh_token": {
                    "description": "Future-ready placeholder; currently not issued.",
                    "type": "string"
                },
                "token_type": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/internal_auth.UserDTO"
                }
            }
        },
        "internal_auth.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "password": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 8
                }
            }
        },
        "internal_auth.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "name": {
                    "type": "string",
                    "maxLength": 120,
                    "minLength": 2
                },
                "password": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 8
                }
            }
        },
        "internal_auth.UserDTO": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "internal_docker.daemonRequest": {
            "type": "object",
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "type": "string",
                    "enum": [
                        "start",
                        "stop",
                        "restart"
                    ]
                }
            }
        },
        "internal_filesystem.createFolderRequest": {
            "type": "object",
            "required": [
                "path"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "maxLength": 2048
                }
            }
        },
        "internal_filesystem.readFileRequest": {
            "type": "object",
            "required": [
                "path"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "maxLength": 2048
                }
            }
        },
        "internal_filesystem.renameRequest": {
            "type": "object",
            "required": [
                "new_path",
                "old_path"
            ],
            "properties": {
                "new_path": {
                    "type": "string",
                    "maxLength": 2048
                },
                "old_path": {
                    "type": "string",
                    "maxLength": 2048
                }
            }
        },
        "internal_projects.createProjectRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "git_auth_type": {
                    "type": "string",
                    "enum": [
                        "ssh",
                        "pat"
                    ]
                },
                "git_pat": {
                    "type": "string"
                },
                "git_ssh_key": {
                    "type": "string"
                },
                "git_url": {
                    "type": "string",
                    "maxLength": 1024
                },
                "name": {
                    "type": "string",
                    "maxLength": 120,
                    "minLength": 2
                },
                "private": {
                    "type": "boolean"
                }
            }
        },
        "models.Project": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "deletedAt": {
                    "type": "string"
                },
                "gitURL": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
