            "get": {
                "description": "Returns host and runtime information (OS, memory, cpu, uptime)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "System info",
                "responses": {
                    "200": {
                        "description": "OK",
