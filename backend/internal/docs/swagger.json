        "/api/v1/files": {
            "get": {
                "description": "List files and folders at an absolute path on the VPS",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Filesystem"
                ],
                "summary": "List files",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Absolute path on VPS (e.g., /home, C:\\\\Users on Windows)",
                        "name": "path",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorBody"
                        }
                    }
                }
            },
            "delete": {
                "description": "Deletes the file or folder at an absolute path",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Filesystem"
                ],
                "summary": "Delete file or folder",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Absolute path to delete",
                        "name": "path",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorBody"
                        }
                    }
                }
            }
        },
