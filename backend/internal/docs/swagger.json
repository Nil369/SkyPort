        "/ws/metrics": {
            "get": {
                "description": "Streams metrics snapshots every 2 seconds over WebSocket\nConnect via ws://host/ws/metrics?token=\u003cJWT\u003e or with Authorization: Bearer \u003cJWT\u003e header",
                "tags": [
                    "Websocket"
                ],
                "summary": "Metrics stream (WebSocket)",
                "responses": {}
            }
        },
        "/ws/terminal": {
            "get": {
                "description": "Opens an interactive shell session over WebSocket\nConnect via ws://host/ws/terminal?token=\u003cJWT\u003e or with Authorization: Bearer \u003cJWT\u003e header\nSend resize control: {\"type\":\"resize\",\"cols\":80,\"rows\":24}",
                "tags": [
                    "Websocket"
                ],
                "summary": "Interactive terminal (WebSocket)",
                "responses": {}
