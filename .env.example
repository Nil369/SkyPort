# SkyPort — example environment file
# Copy to `backend/.env` for local API development (the Go server loads `.env` from its working directory).
# Never commit real secrets. Generate strong values for production.

# ---------------------------------------------------------------------------
# Cross-stack placeholders (frontend / future services)
# The Go server currently uses SKYPORT_* variables below; APP_* are reserved
# for upcoming alignment with the dashboard and installers.
# ---------------------------------------------------------------------------
APP_NAME=SkyPort
APP_ENV=production
APP_PORT=8080

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES=604800
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://skyport.akashhalder.in,https://*.akashhalder.in
TRUSTED_PROXIES=127.0.0.1,::1

# Generic DB path label for docs/tooling; SQLite path for the API is SKYPORT_DB_PATH.
DB_PATH=./data/skyport.db

# ---------------------------------------------------------------------------
# Backend (Go / Fiber) — read by `skyport/internal/config` today
# ---------------------------------------------------------------------------
SKYPORT_HOST=0.0.0.0
SKYPORT_PORT=8080
SKYPORT_DB_PATH=./data/skyport.db
SKYPORT_WORKSPACE_ROOT=./workspace
SKYPORT_ENV=production
SKYPORT_LOG_LEVEL=info
SKYPORT_SHUTDOWN_TIMEOUT_SEC=10
ENABLE_TERMINAL=true
ENABLE_METRICS=true
ENABLE_DOCKER=true
ENABLE_FILESYSTEM=true
ENABLE_PROJECTS=true

# Optional: public base URL for future webhooks and deep links.
# SKYPORT_PUBLIC_URL=http://127.0.0.1:8080

# Optional: disk mount path for host metrics (gopsutil). Leave empty for OS default (/ or C:\).
# SKYPORT_METRICS_DISK_PATH=

# ---------------------------------------------------------------------------
# VPS Cluster Management System
# ---------------------------------------------------------------------------

# Encryption key for storing SSH keys and passwords (base64 encoded 256-bit key)
# Generate with: openssl rand -base64 32
# CRITICAL: Store this securely in production using environment variables or secret management
SKYPORT_ENCRYPTION_KEY=

# SSH session configuration
SSH_SESSION_TIMEOUT=7200
SSH_KEEPALIVE_INTERVAL=300
MAX_SSH_SESSIONS=100

# GitHub release checker configuration
GITHUB_REPO_OWNER=akashhalder
GITHUB_REPO_NAME=skyport
SKYPORT_VERSION=v0.3.0

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# File upload limits (MB)
MAX_UPLOAD_SIZE=500

# Allowed SSH key file extensions
ALLOWED_KEY_TYPES=pem,ppk,key
