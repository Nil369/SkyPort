# SkyPort — example environment file
# Copy to `backend/.env` for local API development (the Go server loads `.env` from its working directory).
# Never commit real secrets. Generate strong values for production.

# ---------------------------------------------------------------------------
# Cross-stack placeholders (frontend / future services)
# The Go server currently uses SKYPORT_* variables below; APP_* are reserved
# for upcoming alignment with the dashboard and installers.
# ---------------------------------------------------------------------------
APP_NAME=SkyPort
APP_ENV=development
APP_PORT=8080

# Used when JWT auth lands; not yet consumed by the current server build.
JWT_SECRET=change-me-to-a-long-random-string

# Generic DB path label for docs/tooling; SQLite path for the API is SKYPORT_DB_PATH.
DB_PATH=./data/skyport.db

# ---------------------------------------------------------------------------
# Backend (Go / Fiber) — read by `skyport/internal/config` today
# ---------------------------------------------------------------------------
SKYPORT_HOST=0.0.0.0
SKYPORT_PORT=8080
SKYPORT_DB_PATH=./data/skyport.db
SKYPORT_ENV=development
SKYPORT_LOG_LEVEL=info
SKYPORT_SHUTDOWN_TIMEOUT_SEC=10

# Optional: public base URL for future webhooks and deep links.
# SKYPORT_PUBLIC_URL=http://127.0.0.1:8080

# Optional: disk mount path for host metrics (gopsutil). Leave empty for OS default (/ or C:\).
# SKYPORT_METRICS_DISK_PATH=
